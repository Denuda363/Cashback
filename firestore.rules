rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Invoices collection
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Customers collection
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Settings collection
    match /settings/{settingsId} {
      allow read, write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
